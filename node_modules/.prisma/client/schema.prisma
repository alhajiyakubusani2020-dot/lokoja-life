// LOKOJA LIFE — the city's register + the cloud save vault (M9 Guest Loop)
// M13 FAMILY SHIELD — a minor account only exists behind a parent PIN and
// collects NOTHING: `contact` is nullable and stays null for kid/teen. The
// parent's PIN hashes with its OWN salt. Columns are added, never broken.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// M9 — a claimed name on the register. The PIN hashes with a per-account
/// salt (scrypt); the session token is the bearer for cloud push/pull.
/// M13 — minors (kid/teen) carry no contact at all and answer to the
/// parent PIN (scrypt, its own salt) for any tier climb.
model Account {
  id            String     @id @default(cuid())
  handle        String     @unique
  contact       String?    @unique
  pinHash       String
  salt          String
  ageBand       String     @default("adult")
  parentPinHash String?
  parentSalt    String?
  token         String?
  cloudSave     CloudSave?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([token])
}

/// M9 — the cloud save vault: one row per account, the whole GameSave as
/// JSON (the same shape the localStorage transport carries — a transport
/// swap, not a redesign).
model CloudSave {
  accountId String   @id
  data      String
  version   Int      @default(10)
  /// M14 — the client HMAC over the save payload (the vault stores it
  /// beside the save; the pull returns it so the client verifies before merge)
  sig       String?
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// M17 LIVE NATION — the thin stateless relay's memory. The relay
// DISTRIBUTES events and keeps only the bookkeeping the nation cannot
// trust to any single client (treasuries, trade rows, circle pots,
// stream boards). It never simulates: no dice, no day-clock, no NPC.
/// A live walker's heartbeat (TTL'd at read time — 90s law).
model LivePresence {
  accountId String   @id
  handle    String
  band      String
  street    String
  status    String
  updatedAt DateTime @updatedAt
}

/// The nation's wire — append-only, cursor-synced (the seq is the cursor).
model LiveEvent {
  seq       Int      @id @default(autoincrement())
  kind      String
  channel   String
  actor     String
  band      String
  payload   String
  createdAt DateTime @default(now())
}

/// A co-op's sealed books — the treasury chain tail is first-class.
model AssociationRow {
  id            String   @id
  name          String
  motto         String
  founder       String
  treasury      Int      @default(0)
  chainTail     String
  ledgerJson    String   @default("[]")
  membersJson   String   @default("[]")
  contractsJson String   @default("[]")
  createdDay    Int      @default(1)
  updatedAt     DateTime @updatedAt
}

/// Player-to-player trades as signed ledger events (the record the court reads).
model TradeRow {
  id         String   @id
  fromHandle String
  toHandle   String
  giveCash   Int      @default(0)
  wantCash   Int      @default(0)
  terms      String
  status     String   @default("offered")
  day        Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Real-player rotating savings — the pot the court guarantees.
model AjoRow {
  id                String   @id
  name              String
  contribution      Int
  orderJson         String
  round             Int      @default(1)
  roundStartDay     Int      @default(1)
  pot               Int      @default(0)
  paidJson          String   @default("{}")
  paidThisRoundJson String   @default("[]")
  defaultersJson    String   @default("[]")
  status            String   @default("open")
  createdDay        Int      @default(1)
  updatedAt         DateTime @updatedAt
}

/// M18 — the "YOUR CITY NEXT?" ballot box: one vote per city per account.
// M20 — the opt-in telemetry counters (one row per account per day;
// a kid account NEVER gets a row — the door 403s before the upsert)
model TelemetryRow {
  id        String   @id @default(cuid())
  accountId String
  day       Int
  counters  String
  createdAt DateTime @default(now())

  @@unique([accountId, day])
}

model ForgeVote {
  id        String   @id @default(cuid())
  accountId String
  city      String
  createdAt DateTime @default(now())
}

/// The stream board — who is live, who watches (viewers-as-crowd).
model StreamRow {
  id          String   @id
  host        String
  kind        String
  title       String
  viewersJson String   @default("[]")
  startedDay  Int      @default(1)
  status      String   @default("live")
  updatedAt   DateTime @updatedAt
}

/// M24 W5 THE CONNECT — the nation's social graph, SERVER truth (the
/// device store stays honest by labeling itself). One row per direction;
/// the PAIR is the relationship. state: 'pending' (requestedBy initiated)
/// | 'friend' | 'blocked' (one-directional refusal wall). Both doors —
/// the nation-wire socket AND the /api/live/action relay — write the
/// SAME rows through the SAME pure laws (systems/socialgraph).
model FriendRow {
  id          Int      @id @default(autoincrement())
  ownerHandle String
  peerHandle  String
  state       String   @default("pending")
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerHandle, peerHandle])
}

/// M24 W5 — the moderation queue: evidence for the union's eyes (the W12
/// console reads it). Nothing automatic happens to a reported handle here.
model ReportRow {
  id           Int      @id @default(autoincrement())
  byHandle     String
  targetHandle String
  reason       String
  status       String   @default("open")
  createdAt    DateTime @default(now())
}

/// M24 W6 THE LEDGER — the nation's purse, SERVER truth. One row per
/// account; the balance is the ONLY thing P2P transfers draw from, so
/// every naira that moves person-to-person passes the server door
/// (N8: ₦500 moves exactly once). version is the optimistic lock.
model WalletRow {
  handle    String   @id
  balance   Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// M24 W6 — the fortress book: append-only, idemKey UNIQUE (a replay
/// returns the SAME receipt and moves NOTHING twice), chainHash linking
/// every row to the last (tamper-evident end to end). createdAt is
/// INTEGER epoch-ms (the Prisma SQLite DateTime law from W4).
model LedgerRow {
  id         Int      @id @default(autoincrement())
  fromHandle String
  toHandle   String
  amount     Int
  kind       String
  idemKey    String   @unique
  chainHash  String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([fromHandle, createdAt])
  @@index([toHandle])
}

/// M24 W1 THE REGISTER — what the street sees. One row per account,
/// created in the SAME transaction as the Account (the identity and
/// its face are born together). avatarLook is the JSON of the REAL
/// vocabularies in data/avatar.ts (validated by systems/profile.ts at
/// every door) — the shape the W2 remote-body renderer will draw.
/// The handle is copied here so roster joins never touch the auth row.
model ProfileRow {
  accountId   String   @id
  handle      String   @unique
  displayName String
  avatarLook  String
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// M24 W10-a THE FLEET — the shared world's wheels are SERVER truth.
/// One row per (owner, model) — the garage law: one car per model per
/// citizen. paint/plate are the WHEELS' FACE (the paint/pplate laws in
/// systems/wheels.ts validate every value at the door); fuel/condition
/// ride 0..1 for the petrol + garage waves (W10-c); x/z/hd is THE PARK
/// SPOT (the car stays where you stopped it — persisted on every park,
/// every bye and every disconnect); odometer is the honest meter the
/// wire itself accumulates from CLAMPED steps (a cheat's metres never
/// enter the books). updatedAt is INTEGER epoch-ms (the Prisma SQLite
/// DateTime law from W4 — the wire writes the same shape).
model VehicleRow {
  id        Int      @id @default(autoincrement())
  handle    String
  model     String
  /// THE DMV LAW (hardening): one plate, ONE row — the uniqueness is now
  /// STRUCTURAL (a second writer cannot clone a plate; the check-then-write
  /// door was the only wall before, and the books already carried 7 clones
  /// of LKO-137-DM). Dedupe ran before this index was born.
  plate     String   @unique
  paint     String   @default("")
  fuel      Float    @default(1)
  condition Float    @default(1)
  x         Float    @default(0)
  z         Float    @default(0)
  hd        Float    @default(0)
  odometer  Float    @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([handle, model])
  @@index([x, z])
}

/// HARDENING INDEXES — the money paths were full table scans:
/// Account WHERE token (every socket handshake), LedgerRow WHERE
/// fromHandle+createdAt (the day-cap eye, every spend), toHandle
/// (receipts + conservation walks), VehicleRow x/z (the parked box).
