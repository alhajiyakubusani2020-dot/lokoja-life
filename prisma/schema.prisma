// LOKOJA LIFE — the city's register + the cloud save vault (M9 Guest Loop)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// M9 — a claimed name on the register. The PIN hashes with a per-account
/// salt (scrypt); the session token is the bearer for cloud push/pull.
/// M14 Fortress will harden this (signed saves, kobo-chain) — the schema
/// is shaped so that migration adds columns, never breaks players.
model Account {
  id        String     @id @default(cuid())
  handle    String     @unique
  contact   String     @unique
  pinHash   String
  salt      String
  ageBand   String     @default("adult")
  token     String?
  cloudSave CloudSave?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// M9 — the cloud save vault: one row per account, the whole GameSave as
/// JSON (the same shape the localStorage transport carries — a transport
/// swap, not a redesign).
model CloudSave {
  accountId String   @id
  data      String
  version   Int      @default(10)
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
