// LOKOJA LIFE — the city's register + the cloud save vault (M9 Guest Loop)
// M13 FAMILY SHIELD — a minor account only exists behind a parent PIN and
// collects NOTHING: `contact` is nullable and stays null for kid/teen. The
// parent's PIN hashes with its OWN salt. Columns are added, never broken.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// M9 — a claimed name on the register. The PIN hashes with a per-account
/// salt (scrypt); the session token is the bearer for cloud push/pull.
/// M13 — minors (kid/teen) carry no contact at all and answer to the
/// parent PIN (scrypt, its own salt) for any tier climb.
model Account {
  id            String     @id @default(cuid())
  handle        String     @unique
  contact       String?    @unique
  pinHash       String
  salt          String
  ageBand       String     @default("adult")
  parentPinHash String?
  parentSalt    String?
  token         String?
  cloudSave     CloudSave?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// M9 — the cloud save vault: one row per account, the whole GameSave as
/// JSON (the same shape the localStorage transport carries — a transport
/// swap, not a redesign).
model CloudSave {
  accountId String   @id
  data      String
  version   Int      @default(10)
  /// M14 — the client HMAC over the save payload (the vault stores it
  /// beside the save; the pull returns it so the client verifies before merge)
  sig       String?
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// M17 LIVE NATION — the thin stateless relay's memory. The relay
// DISTRIBUTES events and keeps only the bookkeeping the nation cannot
// trust to any single client (treasuries, trade rows, circle pots,
// stream boards). It never simulates: no dice, no day-clock, no NPC.
/// A live walker's heartbeat (TTL'd at read time — 90s law).
model LivePresence {
  accountId String   @id
  handle    String
  band      String
  street    String
  status    String
  updatedAt DateTime @updatedAt
}
/// The nation's wire — append-only, cursor-synced (the seq is the cursor).
model LiveEvent {
  seq       Int      @id @default(autoincrement())
  kind      String
  channel   String
  actor     String
  band      String
  payload   String
  createdAt DateTime @default(now())
}
/// A co-op's sealed books — the treasury chain tail is first-class.
model AssociationRow {
  id            String   @id
  name          String
  motto         String
  founder       String
  treasury      Int      @default(0)
  chainTail     String
  ledgerJson    String   @default("[]")
  membersJson   String   @default("[]")
  contractsJson String   @default("[]")
  createdDay    Int      @default(1)
  updatedAt     DateTime @updatedAt
}
/// Player-to-player trades as signed ledger events (the record the court reads).
model TradeRow {
  id         String   @id
  fromHandle String
  toHandle   String
  giveCash   Int      @default(0)
  wantCash   Int      @default(0)
  terms      String
  status     String   @default("offered")
  day        Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
/// Real-player rotating savings — the pot the court guarantees.
model AjoRow {
  id             String   @id
  name           String
  contribution   Int
  orderJson      String
  round          Int      @default(1)
  roundStartDay  Int      @default(1)
  pot            Int      @default(0)
  paidJson       String   @default("{}")
  paidThisRoundJson String @default("[]")
  defaultersJson String   @default("[]")
  status         String   @default("open")
  createdDay     Int      @default(1)
  updatedAt      DateTime @updatedAt
}
/// M18 — the "YOUR CITY NEXT?" ballot box: one vote per city per account.
// M20 — the opt-in telemetry counters (one row per account per day;
// a kid account NEVER gets a row — the door 403s before the upsert)
model TelemetryRow {
  id         String   @id @default(cuid())
  accountId  String
  day        Int
  counters   String
  createdAt  DateTime @default(now())

  @@unique([accountId, day])
}

model ForgeVote {
  id        String   @id @default(cuid())
  accountId String
  city      String
  createdAt DateTime @default(now())
}
/// The stream board — who is live, who watches (viewers-as-crowd).
model StreamRow {
  id          String   @id
  host        String
  kind        String
  title       String
  viewersJson String   @default("[]")
  startedDay  Int      @default(1)
  status      String   @default("live")
  updatedAt   DateTime @updatedAt
}
